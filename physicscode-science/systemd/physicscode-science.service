[Unit]
Description=PhysicsCode science retrieval API (/v1/search)
After=network-online.target vllm-model@bge-m3.service vllm-model@bge-reranker-v2-m3.service
Wants=network-online.target vllm-model@bge-m3.service vllm-model@bge-reranker-v2-m3.service

[Service]
Type=simple
WorkingDirectory=%h/github/physicscode/physicscode-science
Environment=PYTHONPATH=%h/github/physicscode/physicscode-science/src
Environment=PHYSICSCODE_SCIENCE_VECTOR_BACKEND=qdrant
Environment=PHYSICSCODE_SCIENCE_QDRANT_URL=http://127.0.0.1:6333
Environment=PHYSICSCODE_SCIENCE_QDRANT_COLLECTION=physicscode_science_multiview_bge_m3_v2
Environment=PHYSICSCODE_SCIENCE_EMBEDDING_PROVIDER=vllm
Environment=PHYSICSCODE_SCIENCE_EMBEDDING_URL=http://127.0.0.1:8009
Environment=PHYSICSCODE_SCIENCE_EMBEDDING_MODEL=paidynamics/bge-m3-pai
Environment=PHYSICSCODE_SCIENCE_EMBEDDING_MAX_CHARS=6000
Environment=PHYSICSCODE_SCIENCE_EMBEDDING_MAX_TOKENS=1800
Environment=PHYSICSCODE_SCIENCE_API_KEY_FILE=%h/.config/vllm/client_api_key
Environment=PHYSICSCODE_SCIENCE_RERANKER_URL=http://127.0.0.1:8013
Environment=PHYSICSCODE_SCIENCE_RERANKER_MODEL=paidynamics/bge-reranker-v2-m3-pai
ExecStart=/usr/bin/python3 -m physicscode_science.cli.main serve --db .science/physicscode-science.sqlite --host 127.0.0.1 --port 8765
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
