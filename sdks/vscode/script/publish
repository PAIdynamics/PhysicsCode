#!/usr/bin/env bash
set -euo pipefail

mkdir -p dist

echo "Packaging PhysicsCode VS Code extension"
bunx @vscode/vsce package --no-git-tag-version --no-update-package-json --no-dependencies -o dist/physicscode.vsix

echo "Publishing to Visual Studio Marketplace"
if [ -n "${VSCE_PAT:-}" ]; then
  bunx @vscode/vsce publish --packagePath dist/physicscode.vsix -p "$VSCE_PAT"
else
  bunx @vscode/vsce publish --packagePath dist/physicscode.vsix
fi

if [ -n "${OPENVSX_TOKEN:-}" ]; then
  echo "Publishing to Open VSX"
  bunx ovsx publish dist/physicscode.vsix -p "$OPENVSX_TOKEN"
else
  echo "Skipping Open VSX because OPENVSX_TOKEN is not set"
fi
