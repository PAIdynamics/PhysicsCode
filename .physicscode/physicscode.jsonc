{
  "$schema": "https://physicscode.ai/config.json",
  "provider": {},
  "permission": {
    "edit": {
      "packages/physicscode/migration/*": "deny",
    },
  },
  "mcp": {
    "science": {
      "type": "local",
      "command": [
        "python3",
        "-m",
        "physicscode_science.cli.main",
        "mcp",
        "--db",
        "/home/mohsen/github/code/physicscode-science/.science/physicscode-science.sqlite",
      ],
      "environment": {
        "PYTHONPATH": "/home/mohsen/github/code/physicscode-science/src",
        "PHYSICSCODE_SCIENCE_VECTOR_BACKEND": "local",
      },
      "enabled": true,
    },
  },
  "tools": {
    "github-triage": false,
    "github-pr-search": false,
  },
}
